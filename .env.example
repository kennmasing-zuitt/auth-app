# Copy to .env and change every value:  cp .env.example .env

# --- MongoDB ---
MONGO_ROOT_USER=appadmin
MONGO_ROOT_PASSWORD=change-me-long-random
MONGO_DB=authapp

# --- Auth ---
# Generate with:  openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl
SESSION_TTL_SECONDS=3600
BCRYPT_ROUNDS=12
# Keep "false" until HTTPS works, then set to "true" and run: docker compose up -d
COOKIE_SECURE=false

# --- Seed accounts (created by: docker compose exec server npm run seed) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-Admin-123
ADMIN_FIRST_NAME=Kenneth
ADMIN_LAST_NAME=Admin

USER_EMAIL=user@example.com
USER_PASSWORD=ChangeMe-User-123
USER_FIRST_NAME=Juan
USER_LAST_NAME=Dela Cruz
